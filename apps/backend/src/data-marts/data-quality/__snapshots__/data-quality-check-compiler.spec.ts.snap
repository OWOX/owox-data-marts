      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Type mismatch
-- Field: amount
-- Expected Output Schema type: BIGINT
-- sample_value = amount
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the runtime type and up to 1 sample row.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_runtime_type AS (
    SELECT
      NULL AS actual_type
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      actual_type,
      'BIGINT' AS expected_type
    FROM dq_runtime_type
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source."amount" AS sample_value,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    WHERE
      source."amount" IS NOT NULL
    LIMIT 1
  )

SELECT
  summary.is_applicable,
  summary.actual_type,
  summary.expected_type,
  example.example_available,
  example.sample_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "TYPE_MISMATCH",
  },
  {
    "category": "data_freshness",
    "resultShape": {
      "exampleColumns": [
        "latest_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Data freshness
-- Field: updated_at
-- Maximum allowed age: 24 hours
-- latest_value = updated_at
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 1 example row.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_statistics AS (
    SELECT
      COUNT(*) AS row_count,
      MAX("updated_at") AS latest_observed_timestamp
    FROM dq_source
  ),

  dq_summary AS (
    SELECT
      CASE
        WHEN row_count = 0 THEN 0
        ELSE 1
      END AS is_applicable,
      CASE
        WHEN row_count = 0 THEN 0
        WHEN latest_observed_timestamp IS NULL THEN 1
        WHEN
          TIMEZONE(
            'UTC',
            latest_observed_timestamp
          ) < DATEADD(
            day,
            -1,
            CONVERT_TIMEZONE(
              CURRENT_SETTING('timezone'),
              'UTC',
              GETDATE()
            )
          )
          THEN 1
        ELSE 0
      END AS violation_count,
      row_count,
      latest_observed_timestamp,
      DATEADD(
        day,
        -1,
        CONVERT_TIMEZONE(
          CURRENT_SETTING('timezone'),
          'UTC',
          GETDATE()
        )
      ) AS freshness_cutoff_timestamp,
      24 AS threshold_hours
    FROM dq_statistics
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source."updated_at" AS latest_value,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    CROSS JOIN dq_summary AS summary
    WHERE
      summary.violation_count > 0
      AND (
        source."updated_at" = summary.latest_observed_timestamp
        OR (
          source."updated_at" IS NULL
          AND summary.latest_observed_timestamp IS NULL
        )
      )
    LIMIT 1
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  summary.row_count,
  summary.latest_observed_timestamp,
  summary.freshness_cutoff_timestamp,
  summary.threshold_hours,
  example.example_available,
  example.latest_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "negative_values",
    "resultShape": {
      "exampleColumns": [
        "negative_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
