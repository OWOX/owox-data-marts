        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Data freshness
-- Field: updated_at
-- Maximum allowed age: 24 hours
-- latest_value = updated_at
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 1 example row.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_statistics AS (
    SELECT
      COUNT(*) AS row_count,
      MAX(\`updated_at\`) AS latest_observed_timestamp
    FROM dq_source
  ),

  dq_summary AS (
    SELECT
      CASE
        WHEN row_count = 0 THEN 0
        ELSE 1
      END AS is_applicable,
      CASE
        WHEN row_count = 0 THEN 0
        WHEN latest_observed_timestamp IS NULL THEN 1
        WHEN
          latest_observed_timestamp < current_timestamp() - INTERVAL 86400 SECONDS
          THEN 1
        ELSE 0
      END AS violation_count,
      row_count,
      latest_observed_timestamp,
      current_timestamp() - INTERVAL 86400 SECONDS AS freshness_cutoff_timestamp,
      24 AS threshold_hours
    FROM dq_statistics
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source.\`updated_at\` AS latest_value,
      source.\`id\` AS primary_key_value_1,
      source.\`tenant_id\` AS primary_key_value_2
    FROM dq_source AS source
    CROSS JOIN dq_summary AS summary
    WHERE
      summary.violation_count > 0
      AND source.\`updated_at\` <=> summary.latest_observed_timestamp
    LIMIT 1
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  summary.row_count,
  summary.latest_observed_timestamp,
  summary.freshness_cutoff_timestamp,
  summary.threshold_hours,
  example.example_available,
  example.latest_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
