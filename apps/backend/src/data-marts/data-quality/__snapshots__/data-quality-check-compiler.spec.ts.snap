-- source_join_value_2 = customer_id
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_target AS (
    SELECT * FROM analytics.target_table
  ),

