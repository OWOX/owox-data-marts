        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Type mismatch
-- Field: amount
-- Expected Output Schema type: BIGINT
-- sample_value = amount
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the runtime type and up to 1 sample row.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_runtime_type AS (
    SELECT
      typeof((SELECT first(\`amount\`, true) FROM dq_source)) AS actual_type
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      actual_type,
      'BIGINT' AS expected_type
    FROM dq_runtime_type
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source.\`amount\` AS sample_value,
      source.\`id\` AS primary_key_value_1,
      source.\`tenant_id\` AS primary_key_value_2
    FROM dq_source AS source
    WHERE
      source.\`amount\` IS NOT NULL
    LIMIT 1
  )

SELECT
  summary.is_applicable,
  summary.actual_type,
  summary.expected_type,
  example.example_available,
  example.sample_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "TYPE_MISMATCH",
  },
  {
    "category": "data_freshness",
    "resultShape": {
      "exampleColumns": [
        "latest_value",
