        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Relationship integrity
-- Relationship: customers
-- Join: tenant_id -> tenant_id
-- Join: customer_id -> id
-- source_join_value_1 = tenant_id
-- source_join_value_2 = customer_id
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_target AS (
    SELECT * FROM analytics.target_table
  ),

  dq_violations AS (
    SELECT
      source.*
    FROM dq_source AS source
    WHERE
      source.\`tenant_id\` IS NOT NULL
      AND source.\`customer_id\` IS NOT NULL
      AND NOT EXISTS (
        SELECT
          1
        FROM dq_target AS target
        WHERE
          source.\`tenant_id\` = target.\`tenant_id\`
          AND source.\`customer_id\` = target.\`id\`
      )
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COUNT(*) AS violation_count
    FROM dq_violations
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      violation.\`tenant_id\` AS source_join_value_1,
      violation.\`customer_id\` AS source_join_value_2,
      violation.\`id\` AS primary_key_value_1,
      violation.\`tenant_id\` AS primary_key_value_2
    FROM dq_violations AS violation
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.source_join_value_1,
  example.source_join_value_2,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "reverse_relationship",
