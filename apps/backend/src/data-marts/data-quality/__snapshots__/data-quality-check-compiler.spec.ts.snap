    "sql": "-- Data Quality check: Duplicate rows
-- duplicate_value_1 = id
-- duplicate_value_2 = tenant_id
-- duplicate_value_3 = customer_id
-- duplicate_value_4 = amount
-- duplicate_value_5 = updated_at
-- duplicate_value_6 = event_date
-- duplicate_value_7 = payload
-- duplicate_value_8 = secret
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_duplicate_groups AS (
    SELECT
      "id" AS duplicate_value_1,
      "tenant_id" AS duplicate_value_2,
      "customer_id" AS duplicate_value_3,
      "amount" AS duplicate_value_4,
      "updated_at" AS duplicate_value_5,
      "event_date" AS duplicate_value_6,
      JSON_SERIALIZE("payload") AS duplicate_value_7,
      "secret" AS duplicate_value_8,
      COUNT(*) AS duplicate_row_count,
      COUNT(*) - 1 AS extra_row_count
    FROM dq_source
    GROUP BY
      "id",
      "tenant_id",
      "customer_id",
      "amount",
      "updated_at",
      "event_date",
      JSON_SERIALIZE("payload"),
      "secret"
    HAVING
      COUNT(*) > 1
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COALESCE(SUM(extra_row_count), 0) AS violation_count
    FROM dq_duplicate_groups
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      duplicate_group.duplicate_value_1 AS duplicate_value_1,
      duplicate_group.duplicate_value_2 AS duplicate_value_2,
      duplicate_group.duplicate_value_3 AS duplicate_value_3,
      duplicate_group.duplicate_value_4 AS duplicate_value_4,
      duplicate_group.duplicate_value_5 AS duplicate_value_5,
      duplicate_group.duplicate_value_6 AS duplicate_value_6,
      duplicate_group.duplicate_value_7 AS duplicate_value_7,
      duplicate_group.duplicate_value_8 AS duplicate_value_8,
      duplicate_group.duplicate_row_count AS duplicate_row_count,
      duplicate_group.extra_row_count AS extra_row_count
    FROM dq_duplicate_groups AS duplicate_group
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.duplicate_value_1,
  example.duplicate_value_2,
  example.duplicate_value_3,
  example.duplicate_value_4,
  example.duplicate_value_5,
  example.duplicate_value_6,
  example.duplicate_value_7,
  example.duplicate_value_8,
  example.duplicate_row_count,
  example.extra_row_count
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "null_rate",
    "resultShape": {
      "exampleColumns": [
        "null_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Null rate
-- Field: amount
-- Maximum null rate: 5%
-- null_value = amount
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_statistics AS (
    SELECT
      COUNT(*) AS row_count,
      COALESCE(SUM(CASE WHEN "amount" IS NULL THEN 1 ELSE 0 END), 0) AS null_count
    FROM dq_source
  ),

  dq_summary AS (
    SELECT
      CASE
        WHEN row_count = 0 THEN 0
        ELSE 1
      END AS is_applicable,
      CASE
        WHEN row_count = 0 THEN 0
        WHEN
          CASE
            WHEN row_count = 0 THEN NULL
            ELSE null_count::DOUBLE PRECISION * 100 / row_count
          END > 5
          THEN null_count
        ELSE 0
      END AS violation_count,
      row_count,
      null_count,
      CASE
        WHEN row_count = 0 THEN NULL
        ELSE null_count::DOUBLE PRECISION * 100 / row_count
      END AS null_rate_percent,
      5 AS threshold_percent
    FROM dq_statistics
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source."amount" AS null_value,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    CROSS JOIN dq_summary AS summary
    WHERE
      summary.violation_count > 0
      AND source."amount" IS NULL
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  summary.row_count,
  summary.null_count,
  summary.null_rate_percent,
  summary.threshold_percent,
  example.example_available,
  example.null_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "column_uniqueness",
    "resultShape": {
      "exampleColumns": [
        "duplicate_value",
        "duplicate_row_count",
        "duplicate_occurrence_number",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Column uniqueness
-- Field: customer_id
-- duplicate_value = customer_id
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_duplicate_groups AS (
    SELECT
      "customer_id" AS duplicate_value,
      COUNT(*) AS duplicate_row_count,
      COUNT(*) - 1 AS extra_row_count
    FROM dq_source
    WHERE
      "customer_id" IS NOT NULL
    GROUP BY
      "customer_id"
    HAVING
      COUNT(*) > 1
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COALESCE(SUM(extra_row_count), 0) AS violation_count
    FROM dq_duplicate_groups
  ),

  dq_duplicate_occurrences AS (
    SELECT
      source."customer_id" AS duplicate_value,
      duplicate_group.duplicate_row_count AS duplicate_row_count,
      ROW_NUMBER() OVER (
        PARTITION BY source."customer_id"
        ORDER BY source."customer_id"
      ) AS duplicate_occurrence_number,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    INNER JOIN dq_duplicate_groups AS duplicate_group
      ON (
        source."customer_id" = duplicate_group.duplicate_value
        OR (
          source."customer_id" IS NULL
          AND duplicate_group.duplicate_value IS NULL
        )
      )
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      duplicate_occurrence.duplicate_value AS duplicate_value,
      duplicate_occurrence.duplicate_row_count AS duplicate_row_count,
      duplicate_occurrence.duplicate_occurrence_number AS duplicate_occurrence_number,
      duplicate_occurrence.primary_key_value_1 AS primary_key_value_1,
      duplicate_occurrence.primary_key_value_2 AS primary_key_value_2
    FROM dq_duplicate_occurrences AS duplicate_occurrence
    WHERE
      duplicate_occurrence.duplicate_occurrence_number > 1
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.duplicate_value,
  example.duplicate_row_count,
  example.duplicate_occurrence_number,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "constant_column",
    "resultShape": {
      "exampleColumns": [
        "constant_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
