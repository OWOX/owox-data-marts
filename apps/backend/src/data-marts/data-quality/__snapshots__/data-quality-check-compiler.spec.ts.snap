exports[`DataQualityCheckCompiler matches the available SQL contract snapshot for AWS_ATHENA 1`] = `
[
  {
    "category": "empty_table",
    "resultShape": {
      "exampleColumns": [],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Empty table
-- Returns the full violation count.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_statistics AS (
    SELECT
      COUNT(*) AS row_count
    FROM dq_source
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      CASE
        WHEN row_count = 0 THEN 1
        ELSE 0
      END AS violation_count,
      row_count
    FROM dq_statistics
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  summary.row_count,
  NULL AS example_available
FROM dq_summary AS summary",
    "strategy": "COUNT",
  },
  {
    "category": "pk_uniqueness",
    "resultShape": {
      "exampleColumns": [
        "primary_key_value_1",
        "primary_key_value_2",
        "duplicate_row_count",
        "extra_row_count",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Primary key uniqueness
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_duplicate_groups AS (
    SELECT
      "id" AS primary_key_value_1,
      "tenant_id" AS primary_key_value_2,
      COUNT(*) AS duplicate_row_count,
      COUNT(*) - 1 AS extra_row_count
    FROM dq_source
    WHERE
      "id" IS NOT NULL
      AND "tenant_id" IS NOT NULL
    GROUP BY
      "id",
      "tenant_id"
    HAVING
      COUNT(*) > 1
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COALESCE(SUM(extra_row_count), 0) AS violation_count
    FROM dq_duplicate_groups
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      duplicate_group.primary_key_value_1 AS primary_key_value_1,
      duplicate_group.primary_key_value_2 AS primary_key_value_2,
      duplicate_group.duplicate_row_count AS duplicate_row_count,
      duplicate_group.extra_row_count AS extra_row_count
    FROM dq_duplicate_groups AS duplicate_group
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.primary_key_value_1,
  example.primary_key_value_2,
  example.duplicate_row_count,
  example.extra_row_count
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "duplicate_rows",
    "resultShape": {
      "exampleColumns": [
        "duplicate_value_1",
        "duplicate_value_2",
        "duplicate_value_3",
        "duplicate_value_4",
        "duplicate_value_5",
        "duplicate_value_6",
        "duplicate_value_7",
        "duplicate_value_8",
        "duplicate_row_count",
        "extra_row_count",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Duplicate rows
-- duplicate_value_1 = id
-- duplicate_value_2 = tenant_id
-- duplicate_value_3 = customer_id
-- duplicate_value_4 = amount
-- duplicate_value_5 = updated_at
-- duplicate_value_6 = event_date
-- duplicate_value_7 = payload
-- duplicate_value_8 = secret
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_duplicate_groups AS (
    SELECT
      "id" AS duplicate_value_1,
      "tenant_id" AS duplicate_value_2,
      "customer_id" AS duplicate_value_3,
      "amount" AS duplicate_value_4,
      "updated_at" AS duplicate_value_5,
      "event_date" AS duplicate_value_6,
      json_format(CAST("payload" AS JSON)) AS duplicate_value_7,
      "secret" AS duplicate_value_8,
      COUNT(*) AS duplicate_row_count,
      COUNT(*) - 1 AS extra_row_count
    FROM dq_source
    GROUP BY
      "id",
      "tenant_id",
      "customer_id",
      "amount",
      "updated_at",
      "event_date",
      json_format(CAST("payload" AS JSON)),
      "secret"
    HAVING
      COUNT(*) > 1
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COALESCE(SUM(extra_row_count), 0) AS violation_count
    FROM dq_duplicate_groups
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      duplicate_group.duplicate_value_1 AS duplicate_value_1,
      duplicate_group.duplicate_value_2 AS duplicate_value_2,
      duplicate_group.duplicate_value_3 AS duplicate_value_3,
      duplicate_group.duplicate_value_4 AS duplicate_value_4,
      duplicate_group.duplicate_value_5 AS duplicate_value_5,
      duplicate_group.duplicate_value_6 AS duplicate_value_6,
      duplicate_group.duplicate_value_7 AS duplicate_value_7,
      duplicate_group.duplicate_value_8 AS duplicate_value_8,
      duplicate_group.duplicate_row_count AS duplicate_row_count,
      duplicate_group.extra_row_count AS extra_row_count
    FROM dq_duplicate_groups AS duplicate_group
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.duplicate_value_1,
  example.duplicate_value_2,
  example.duplicate_value_3,
  example.duplicate_value_4,
  example.duplicate_value_5,
  example.duplicate_value_6,
  example.duplicate_value_7,
  example.duplicate_value_8,
  example.duplicate_row_count,
  example.extra_row_count
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "null_rate",
    "resultShape": {
      "exampleColumns": [
        "null_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Null rate
-- Field: amount
-- Maximum null rate: 5%
-- null_value = amount
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_statistics AS (
    SELECT
      COUNT(*) AS row_count,
      COALESCE(SUM(CASE WHEN "amount" IS NULL THEN 1 ELSE 0 END), 0) AS null_count
    FROM dq_source
  ),

  dq_summary AS (
    SELECT
      CASE
        WHEN row_count = 0 THEN 0
        ELSE 1
      END AS is_applicable,
      CASE
        WHEN row_count = 0 THEN 0
        WHEN
          CASE
            WHEN row_count = 0 THEN NULL
            ELSE CAST(null_count AS DOUBLE) * 100 / row_count
          END > 5
          THEN null_count
        ELSE 0
      END AS violation_count,
      row_count,
      null_count,
      CASE
        WHEN row_count = 0 THEN NULL
        ELSE CAST(null_count AS DOUBLE) * 100 / row_count
      END AS null_rate_percent,
      5 AS threshold_percent
    FROM dq_statistics
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source."amount" AS null_value,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    CROSS JOIN dq_summary AS summary
    WHERE
      summary.violation_count > 0
      AND source."amount" IS NULL
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  summary.row_count,
  summary.null_count,
  summary.null_rate_percent,
  summary.threshold_percent,
  example.example_available,
  example.null_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "column_uniqueness",
    "resultShape": {
      "exampleColumns": [
        "duplicate_value",
        "duplicate_row_count",
        "duplicate_occurrence_number",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Column uniqueness
-- Field: customer_id
-- duplicate_value = customer_id
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_duplicate_groups AS (
    SELECT
      "customer_id" AS duplicate_value,
      COUNT(*) AS duplicate_row_count,
      COUNT(*) - 1 AS extra_row_count
    FROM dq_source
    WHERE
      "customer_id" IS NOT NULL
    GROUP BY
      "customer_id"
    HAVING
      COUNT(*) > 1
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COALESCE(SUM(extra_row_count), 0) AS violation_count
    FROM dq_duplicate_groups
  ),

  dq_duplicate_occurrences AS (
    SELECT
      source."customer_id" AS duplicate_value,
      duplicate_group.duplicate_row_count AS duplicate_row_count,
      ROW_NUMBER() OVER (
        PARTITION BY source."customer_id"
        ORDER BY source."customer_id"
      ) AS duplicate_occurrence_number,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    INNER JOIN dq_duplicate_groups AS duplicate_group
      ON source."customer_id" IS NOT DISTINCT FROM duplicate_group.duplicate_value
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      duplicate_occurrence.duplicate_value AS duplicate_value,
      duplicate_occurrence.duplicate_row_count AS duplicate_row_count,
      duplicate_occurrence.duplicate_occurrence_number AS duplicate_occurrence_number,
      duplicate_occurrence.primary_key_value_1 AS primary_key_value_1,
      duplicate_occurrence.primary_key_value_2 AS primary_key_value_2
    FROM dq_duplicate_occurrences AS duplicate_occurrence
    WHERE
      duplicate_occurrence.duplicate_occurrence_number > 1
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.duplicate_value,
  example.duplicate_row_count,
  example.duplicate_occurrence_number,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "constant_column",
    "resultShape": {
      "exampleColumns": [
        "constant_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Constant column
-- Field: secret
-- constant_value = secret
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 1 example row.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_statistics AS (
    SELECT
      COUNT(*) AS row_count,
      COUNT(DISTINCT "secret") + CASE WHEN COUNT(*) > COUNT("secret") THEN 1 ELSE 0 END AS distinct_value_count
    FROM dq_source
  ),

  dq_summary AS (
    SELECT
      CASE
        WHEN row_count = 0 THEN 0
        ELSE 1
      END AS is_applicable,
      CASE
        WHEN row_count = 0 THEN 0
        WHEN distinct_value_count = 1 THEN 1
        ELSE 0
      END AS violation_count,
      row_count,
      distinct_value_count
    FROM dq_statistics
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source."secret" AS constant_value,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    CROSS JOIN dq_summary AS summary
    WHERE
      summary.violation_count > 0
    LIMIT 1
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  summary.row_count,
  summary.distinct_value_count,
  example.example_available,
  example.constant_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "type_mismatch",
    "resultShape": {
      "actualTypeColumn": "actual_type",
      "actualTypeMetadataColumn": "sample_value",
      "exampleColumns": [
        "sample_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Type mismatch
-- Field: amount
-- Expected Output Schema type: BIGINT
-- sample_value = amount
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the runtime type and up to 1 sample row.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_runtime_type AS (
    SELECT
      typeof((SELECT arbitrary("amount") FROM dq_source)) AS actual_type
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      actual_type,
      'BIGINT' AS expected_type
    FROM dq_runtime_type
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source."amount" AS sample_value,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    WHERE
      source."amount" IS NOT NULL
    LIMIT 1
  )

SELECT
  summary.is_applicable,
  summary.actual_type,
  summary.expected_type,
  example.example_available,
  example.sample_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "TYPE_MISMATCH",
  },
  {
    "category": "data_freshness",
    "resultShape": {
      "exampleColumns": [
        "latest_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Data freshness
-- Field: updated_at
-- Maximum allowed age: 24 hours
-- latest_value = updated_at
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 1 example row.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_statistics AS (
    SELECT
      COUNT(*) AS row_count,
      MAX("updated_at") AS latest_observed_timestamp
    FROM dq_source
  ),

  dq_summary AS (
    SELECT
      CASE
        WHEN row_count = 0 THEN 0
        ELSE 1
      END AS is_applicable,
      CASE
        WHEN row_count = 0 THEN 0
        WHEN latest_observed_timestamp IS NULL THEN 1
        WHEN
          latest_observed_timestamp < current_timestamp - INTERVAL '86400' SECOND
          THEN 1
        ELSE 0
      END AS violation_count,
      row_count,
      latest_observed_timestamp,
      current_timestamp - INTERVAL '86400' SECOND AS freshness_cutoff_timestamp,
      24 AS threshold_hours
    FROM dq_statistics
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      source."updated_at" AS latest_value,
      source."id" AS primary_key_value_1,
      source."tenant_id" AS primary_key_value_2
    FROM dq_source AS source
    CROSS JOIN dq_summary AS summary
    WHERE
      summary.violation_count > 0
      AND source."updated_at" IS NOT DISTINCT FROM summary.latest_observed_timestamp
    LIMIT 1
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  summary.row_count,
  summary.latest_observed_timestamp,
  summary.freshness_cutoff_timestamp,
  summary.threshold_hours,
  example.example_available,
  example.latest_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "negative_values",
    "resultShape": {
      "exampleColumns": [
        "negative_value",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Negative values
-- Field: amount
-- negative_value = amount
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_violations AS (
    SELECT
      *
    FROM dq_source
    WHERE
      "amount" IS NOT NULL
      AND "amount" < 0
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COUNT(*) AS violation_count
    FROM dq_violations
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      violation."amount" AS negative_value,
      violation."id" AS primary_key_value_1,
      violation."tenant_id" AS primary_key_value_2
    FROM dq_violations AS violation
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.negative_value,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "relationship_integrity",
    "resultShape": {
      "exampleColumns": [
        "source_join_value_1",
        "source_join_value_2",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Relationship integrity
-- Relationship: customers
-- Join: tenant_id -> tenant_id
-- Join: customer_id -> id
-- source_join_value_1 = tenant_id
-- source_join_value_2 = customer_id
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_target AS (
    SELECT * FROM analytics.target_table
  ),

  dq_violations AS (
    SELECT
      source.*
    FROM dq_source AS source
    WHERE
      source."tenant_id" IS NOT NULL
      AND source."customer_id" IS NOT NULL
      AND NOT EXISTS (
        SELECT
          1
        FROM dq_target AS target
        WHERE
          source."tenant_id" = target."tenant_id"
          AND source."customer_id" = target."id"
      )
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COUNT(*) AS violation_count
    FROM dq_violations
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      violation."tenant_id" AS source_join_value_1,
      violation."customer_id" AS source_join_value_2,
      violation."id" AS primary_key_value_1,
      violation."tenant_id" AS primary_key_value_2
    FROM dq_violations AS violation
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.source_join_value_1,
  example.source_join_value_2,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "reverse_relationship",
    "resultShape": {
      "exampleColumns": [
        "target_join_value_1",
        "target_join_value_2",
        "primary_key_value_1",
        "primary_key_value_2",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Reverse relationship
-- Relationship: customers
-- Join: tenant_id -> tenant_id
-- Join: customer_id -> id
-- target_join_value_1 = tenant_id
-- target_join_value_2 = id
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_target AS (
    SELECT * FROM analytics.target_table
  ),

  dq_violations AS (
    SELECT
      target.*
    FROM dq_target AS target
    WHERE
      target."tenant_id" IS NOT NULL
      AND target."id" IS NOT NULL
      AND NOT EXISTS (
        SELECT
          1
        FROM dq_source AS source
        WHERE
          source."tenant_id" = target."tenant_id"
          AND source."customer_id" = target."id"
      )
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COUNT(*) AS violation_count
    FROM dq_violations
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      violation."tenant_id" AS target_join_value_1,
      violation."id" AS target_join_value_2,
      violation."id" AS primary_key_value_1,
      violation."tenant_id" AS primary_key_value_2
    FROM dq_violations AS violation
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.target_join_value_1,
  example.target_join_value_2,
  example.primary_key_value_1,
  example.primary_key_value_2
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
]
`;

exports[`DataQualityCheckCompiler matches the available SQL contract snapshot for AWS_REDSHIFT 1`] = `
[
  {
    "category": "empty_table",
    "resultShape": {
      "exampleColumns": [],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Empty table
-- Returns the full violation count.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_statistics AS (
    SELECT
      COUNT(*) AS row_count
    FROM dq_source
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      CASE
        WHEN row_count = 0 THEN 1
        ELSE 0
      END AS violation_count,
      row_count
    FROM dq_statistics
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  summary.row_count,
  NULL AS example_available
FROM dq_summary AS summary",
    "strategy": "COUNT",
  },
  {
    "category": "pk_uniqueness",
    "resultShape": {
      "exampleColumns": [
        "primary_key_value_1",
        "primary_key_value_2",
        "duplicate_row_count",
        "extra_row_count",
      ],
      "exampleMarkerColumn": "example_available",
    },
    "sql": "-- Data Quality check: Primary key uniqueness
-- primary_key_value_1 = id
-- primary_key_value_2 = tenant_id
-- Returns the full violation count and up to 3 example rows.

WITH
  dq_source AS (
    SELECT * FROM analytics.source_table
  ),

  dq_duplicate_groups AS (
    SELECT
      "id" AS primary_key_value_1,
      "tenant_id" AS primary_key_value_2,
      COUNT(*) AS duplicate_row_count,
      COUNT(*) - 1 AS extra_row_count
    FROM dq_source
    WHERE
      "id" IS NOT NULL
      AND "tenant_id" IS NOT NULL
    GROUP BY
      "id",
      "tenant_id"
    HAVING
      COUNT(*) > 1
  ),

  dq_summary AS (
    SELECT
      1 AS is_applicable,
      COALESCE(SUM(extra_row_count), 0) AS violation_count
    FROM dq_duplicate_groups
  ),

  dq_examples AS (
    SELECT
      1 AS example_available,
      duplicate_group.primary_key_value_1 AS primary_key_value_1,
      duplicate_group.primary_key_value_2 AS primary_key_value_2,
      duplicate_group.duplicate_row_count AS duplicate_row_count,
      duplicate_group.extra_row_count AS extra_row_count
    FROM dq_duplicate_groups AS duplicate_group
    LIMIT 3
  )

SELECT
  summary.is_applicable,
  summary.violation_count,
  example.example_available,
  example.primary_key_value_1,
  example.primary_key_value_2,
  example.duplicate_row_count,
  example.extra_row_count
FROM dq_summary AS summary
LEFT JOIN dq_examples AS example
  ON TRUE",
    "strategy": "COUNT",
  },
  {
    "category": "duplicate_rows",
    "resultShape": {
      "exampleColumns": [
